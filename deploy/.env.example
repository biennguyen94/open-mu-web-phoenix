# Copy to phoenix/deploy/.env (gitignored). Values are read by config/runtime.exs.

# --- Phoenix ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Host name / IP used to reach the site (links, cookies); e.g. localhost or the VPS IP
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4000
# PHX_FORCE_SSL=true   # only behind HTTPS

# --- OpenMU database (existing, shared with the game server) ---
# Inside the Docker network the host is `database`, port 5432.
DATABASE_URL=postgresql://USER:PASS@database:5432/openmu
POOL_SIZE=10

# --- OpenMU admin panel (status of the game server) ---
GAMESERVER_URL=http://openmu-startup:8080

# --- Website settings (same names as the Next.js app) ---
NEXT_PUBLIC_GOODLE_DRIVE_LINK=
NEXT_PUBLIC_MEDIAFIRE_LINK=
NEXT_PUBLIC_MEGA_LINK=
NEXT_PUBLIC_DISCORD_LINK=
NEXT_PUBLIC_ZEN_TO_RESET=1000000
LVL_TO_RESET=400
MAX_RESET=6
NEXT_PUBLIC_ZEN_TO_PKCLEAR=1000000
NEXT_PUBLIC_ZEN_TO_RESET_STATS=1000000
